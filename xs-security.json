{
  "xsappname": "mdg-services-nodejs",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.MDG.Access",
      "description": "Access to MDG services"
    },
    {
      "name": "$XSAPPNAME.MDG.Admin",
      "description": "Admin access for MDG configuration"
    }
  ],
  "role-templates": [
    {
      "name": "MDG_Access",
      "description": "MDG - Access",
      "scope-references": [
        "$XSAPPNAME.MDG.Access"
      ]
    },
    {
      "name": "MDG_Admin",
      "description": "MDG - Admin",
      "scope-references": [
        "$XSAPPNAME.MDG.Admin"
      ]
    }
  ]
}
